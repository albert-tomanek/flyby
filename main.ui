<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.1 -->
<interface>
  <!-- interface-name example -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.6"/>
  <template class="FlyByMainWindow" parent="GtkApplicationWindow">
    <property name="name">FlyBy</property>
    <property name="title">FlyBy</property>
    <property name="titlebar">titlebar</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="titlebar">
        <child type="end">
          <object class="GtkMenuButton">
            <property name="popover">goggles_popover</property>
            <property name="tooltip-markup">Properties of the anaglyphic glasses used</property>
            <child>
              <object class="GtkImage">
                <property name="resource">/org/neocities/albertt/flyby/glasses1.svg</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="css-classes">linked</property>
            <property name="halign">start</property>
            <child>
              <object class="GtkButton">
                <property name="action-name">win.open</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-open</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">O_pen</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </property>
                <style>
                  <class name="text-button"/>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="action-name">win.save-as</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-save-as</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">S_ave</property>
                        <property name="use-underline">True</property>
                      </object>
                    </child>
                  </object>
                </property>
                <style>
                  <class name="text-button"/>
                  <class name="image-button"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton">
                <property name="menu-model">export_menu</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkPaned">
        <child>
          <object class="GtkBox" id="sidebar">
            <property name="orientation">vertical</property>
            <property name="vexpand">True</property>
            <property name="width-request">200</property>
            <child>
              <object class="GtkStack" id="sidebar_stack">
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkLabel" id="drop_placeholder_label">
                    <property name="css-classes">caption-heading</property>
                    <property name="hexpand">True</property>
                    <property name="justify">center</property>
                    <property name="label">Drop image or video files to import as frames.</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-end">24</property>
                    <property name="margin-start">24</property>
                    <property name="margin-top">24</property>
                    <property name="vexpand">True</property>
                    <property name="wrap">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="GtkColumnView" id="frame_listview">
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkOverlay">
                <property name="vexpand">True</property>
                <child type="overlay">
                  <object class="GtkBox" id="media_bar">
                    <property name="css-classes">osd</property>
                    <property name="hexpand">True</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="name">position-bar</property>
                    <property name="spacing">10</property>
                    <property name="valign">end</property>
                    <child>
                      <object class="GtkToggleButton" id="play_button">
                        <property name="css-classes">linked</property>
                        <property name="icon-name">media-playback-start-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="fps_box">
                        <property name="adjustment">fps_adj</property>
                        <property name="numeric">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="position_scale">
                        <property name="adjustment">
                          <object class="GtkAdjustment" id="position_adj"/>
                        </property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                    <style/>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="stage_box">
                    <property name="css-classes">stage</property>
                    <property name="height-request">300</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="titlebar">
      <object class="GtkHeaderBar"/>
    </child>
  </template>
  <object class="GtkPopover" id="open_popover"/>
  <object class="GtkAdjustment" id="redboost_adj">
    <property name="lower">0.5</property>
    <property name="upper">3.0</property>
    <property name="value">1.0</property>
  </object>
  <object class="GtkPopover" id="popover_open">
    <property name="child">
      <object class="GtkListBox">
        <child>
          <object class="GtkButton">
            <property name="label">Video</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="label">Burst</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="label">Stereo pair</property>
          </object>
        </child>
      </object>
    </property>
  </object>
  <object class="GtkAdjustment" id="fps_adj">
    <property name="lower">1.0</property>
    <property name="step-increment">1.0</property>
    <property name="upper">120.0</property>
    <property name="value">12.0</property>
  </object>
  <menu id="export_menu">
    <item>
      <attribute name="action">win.export-composite</attribute>
      <attribute name="label">Export composite image</attribute>
    </item>
    <item>
      <attribute name="action">win.export-stereo</attribute>
      <attribute name="label">Export stereo image</attribute>
    </item>
    <item>
      <attribute name="action">win.export-gif</attribute>
      <attribute name="label">Export Wiggle _GIF</attribute>
    </item>
  </menu>
  <object class="GtkPopover" id="goggles_popover">
    <child>
      <object class="GtkListBox">
        <property name="css-classes">rich-list
boxed-list</property>
        <child>
          <object class="GtkListBoxRow">
            <property name="selectable">False</property>
            <property name="tooltip-markup">In some anaglyphic glasses the red filter is darker than the blue filter. Boosting the red channel can compensate for this.</property>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkLabel">
                    <property name="can-focus">False</property>
                    <property name="can-target">False</property>
                    <property name="label">Red boost</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScale">
                    <property name="adjustment">redboost_adj</property>
                    <property name="draw-value">True</property>
                    <property name="has-tooltip">True</property>
                    <property name="hexpand">True</property>
                    <property name="value-pos">left</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkListBoxRow">
            <property name="selectable">False</property>
            <property name="tooltip-text">The type of anaglyph to create</property>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkLabel">
                    <property name="can-focus">False</property>
                    <property name="can-target">False</property>
                    <property name="halign">start</property>
                    <property name="label">Anaglyph mode</property>
                    <property name="width-request">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkShortcutLabel">
                    <property name="accelerator">M</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkComboBoxText" id="ana_mode_box">
                    <property name="active">0</property>
                    <property name="editing-canceled">True</property>
                    <property name="entry-text-column">0</property>
                    <property name="halign">end</property>
                    <property name="has-tooltip">True</property>
                    <items>
                      <item id="0">None</item>
                      <item id="1">Monochrome</item>
                      <item id="2">Grayscale</item>
                      <item id="3">Half-color</item>
                      <item id="4">Full-color</item>
                    </items>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkListBoxRow" id="altern_row">
            <property name="selectable">False</property>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkLabel">
                    <property name="halign">start</property>
                    <property name="label">Alternate frames</property>
                  </object>
                </child>
                <child>
                  <object class="GtkShortcutLabel">
                    <property name="accelerator">A</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="altern_switch">
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
