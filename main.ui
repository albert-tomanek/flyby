<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.10.3 -->
<interface>
  <!-- interface-name example -->
  <requires lib="gtk" version="4.6"/>
  <template class="FlyBy" parent="GtkApplicationWindow">
    <property name="name">FlyBy</property>
    <property name="title">FlyBy</property>
    <property name="titlebar">titlebar</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkImage" id="stage">
            <property name="height-request">600</property>
            <property name="name">stage</property>
            <property name="vexpand">True</property>
            <property name="width-request">720</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="halign">end</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkScale">
                <property name="adjustment">adj_framediff</property>
                <property name="digits">0</property>
                <property name="draw-value">True</property>
                <property name="round-digits">0</property>
                <property name="value-pos">left</property>
                <property name="width-request">200</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Method:</property>
              </object>
            </child>
            <child>
              <object class="GtkComboBoxText" id="ana_mode_box">
                <property name="active">0</property>
                <property name="editing-canceled">True</property>
                <property name="entry-text-column">0</property>
                <property name="has-entry">True</property>
                <property name="has-tooltip">True</property>
                <property name="model">anaglyph_mode_store</property>
                <property name="tooltip-text">The type of anaglyph to create</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="titlebar">
        <child>
          <object class="GtkMenuButton">
            <property name="icon-name">document-open-symbolic</property>
            <property name="label">Open</property>
            <property name="popover">open_popover</property>
            <property name="visible">False</property>
            <signal name="activate" handler="on_open_file"/>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="label">Open</property>
            <signal name="clicked" handler="on_open_file"/>
          </object>
        </child>
        <child type="end">
          <object class="GtkMenuButton">
            <child>
              <object class="GtkImage">
                <property name="resource">/com/github/albert-tomanek/flyby/glasses2.svg</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="play_button">
            <property name="css-classes">suggested-action</property>
            <property name="icon-name">media-playback-start-symbolic</property>
            <signal name="toggled" handler="on_play_clicked"/>
          </object>
        </child>
      </object>
    </child>
    <child type="titlebar">
      <object class="GtkHeaderBar"/>
    </child>
  </template>
  <object class="GtkListStore" id="anaglyph_mode_store">
    <columns>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">True</col>
      </row>
      <row>
        <col id="0">Grayscale</col>
      </row>
      <row>
        <col id="0">Half-Color</col>
      </row>
      <row>
        <col id="0">Full-Color</col>
      </row>
    </data>
  </object>
  <object class="GtkAdjustment" id="adj_framediff">
    <property name="lower">-2000.0</property>
    <property name="page-increment">100.0</property>
    <property name="step-increment">10.0</property>
    <property name="upper">2000.0</property>
    <property name="value">200.0</property>
    <signal name="value-changed" handler="on_frame_difference_changed" after="yes"/>
  </object>
  <object class="GtkPopover" id="open_popover"/>
</interface>
